{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "PolyFactory Ores Compat",
  "description": "Compat for Patbox's PolyFactory, adding support for global Ores.",
  "authors": [
    "Relism"
  ],
  "contact": {},
  "license": "AGPL-3.0",
  "environment": "server",
  "entrypoints": {
    "fabric-datagen": [
      "dev.relism.polyfactory_ores_compat.client.PolyFactoryOresCompatDataGenerator"
    ],
    "main": [
      "dev.relism.polyfactory_ores_compat.PolyFactoryOresCompat"
    ]
  },
  "mixins": [
    "polyfactory_ores_compat.mixins.json",
    {
      "config": "polyfactory_ores_compat.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "polyfactory": ">=${polyfactory_version}"
  }
}
